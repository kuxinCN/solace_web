# ============================================================================
# 复制成 .env.local 后按你的服务器情况填写（.env.local 不要提交到仓库）
# ============================================================================

# ---------------------------------------------------------------------------
# 1. MySQL（宝塔里创建的那个库，后台和用户端共用这一个库）
#    这几项也可以留空：第一次部署时访问 /install 安装向导里填，
#    或者在后台「数据库」页面里填，都会保存到 config/db.json
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solace
DB_PASSWORD=
DB_NAME=solace

# ---------------------------------------------------------------------------
# 2. 对话 AI（可选）
#    正常应该去后台「对话 AI」页面配置；这里只在数据库还没配好时当兜底用
# ---------------------------------------------------------------------------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---------------------------------------------------------------------------
# 3. 后台安全（可选，建议设置）
# ---------------------------------------------------------------------------
# 设置后：安装向导 / 后台初始化会要求填写该口令，未登录时改数据库配置也要校验
ADMIN_SETUP_KEY=
# 邮箱验证码的加盐密钥，随便换成一串随机字符即可
CODE_SECRET=
# 用户密码的「可逆加密」密钥：后台「用户管理」里能查看明文密码，就是靠它加密的
# ⚠️ 设置后不要随意更换：换了之后库里已经存过的密码会解不开，需要在后台重新保存一次
USER_PASSWORD_KEY=

# ---------------------------------------------------------------------------
# 4. 重新安装（平时千万别开）
# ---------------------------------------------------------------------------
# 只有「忘记验证器 / 想换管理员」时，才把下面两行打开；装完立刻删掉！
# 注意：开了 ALLOW_REINSTALL 就必须同时设 REINSTALL_KEY，
#       否则重装接口会直接拒绝（防止安装入口被外人用来重置管理员）
# ALLOW_REINSTALL=1
# REINSTALL_KEY=临时的一串随机口令

# ---------------------------------------------------------------------------
# 5. 用户端（聊天 / 日记）—— 不需要额外配置
# ---------------------------------------------------------------------------
# 用户端的数据和后台存在同一个 MySQL 库里，用的是上面第 1 节的连接。
# 用户登录方式是邮箱验证码，发信走后台「邮箱 / 验证码」页面里配置的网易 SMTP。
